@using Microsoft.AspNetCore.Mvc;
@section Styles {
    <link rel="stylesheet" href="~/css/Estilos/cssEncriptar.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/Scripts/jsEncriptar.js" asp-append-version="true"></script>
}

<div class="container-fluid col-12 col-md-10 col-lg-8 col-xxl-6 text-start">
    <br /><br />
    <div class="d-flex gap-3 align-items-center" style="min-height: 3rem;">
        <a class="btn btn-secondary d-flex p-2" asp-controller="Admin" asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h4 class="text-start m-0">Encriptar</h4>
    </div>
    <br />
    <div class="card-body px-4 pb-4 pt-0">
        <form id="formEncriptar" data-url="@Url.Action("Encriptar", "Encriptar")">
            <div class="mb-4">
                <label for="txtEncriptar" class="form-label fw-semibold text-secondary small mb-2">Texto a encriptar</label>
                <textarea class="form-control bg-light border-secondary-subtle" id="txtEncriptar" name="texto" rows="3" placeholder="Ingresa el texto a encriptar" required></textarea>
            </div>
            <button id="btnEncriptar" type="submit" class="btn btn-primary w-100 fw-semibold py-2 shadow-sm">
                Encriptar
            </button>
            <div id="divResultadoEncriptar" class="mt-4 text-break"></div>
        </form>
    </div>
</div>